{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quinn0823-github-io",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.jchiu.dpdns.org/*",
      "zone_name": "jchiu.dpdns.org"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./.vitepress/dist"
  }
}
